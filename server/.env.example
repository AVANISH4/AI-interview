# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_interview_pro?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=super_secret_jwt_key_ai_interview_pro_2026_change_in_production
JWT_EXPIRES_IN=7d

# OpenAI API Key (Optional: fallback engine is active if key is not provided)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Stripe Integration (Optional: test payment simulation mode active if key is missing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Configuration (Nodemailer - Optional: log mode if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AI Interview Pro <noreply@aiinterviewpro.com>
